# App Settings
DEBUG             = False
# The SECRET_KEY is used for signing the session cookie.
SECRET_KEY        = 'CHANGE ME'
# The SITE_NAME is displayed on every page and email.
SITE_NAME         = 'Otterwiki'
# Configure the path to the repository:
REPOSITORY        = '/path/to/the/repository/root'

# 多空间：独立空间仓库的根目录。
# 每个空间拥有独立的 git 仓库（<SPACES_ROOT>/<空间ID>/repository），
# 默认为 REPOSITORY 的同级目录 spaces。升级后通过 'flask db upgrade' 完成迁移，
# 详见 docs/multi-space-upgrade.md。
# SPACES_ROOT      = '/path/to/the/spaces/root'

# 全局文档字号（px，整数，12 到 24，默认 15）。
# 只影响文档正文的排版层级，导航、按钮、管理界面和编辑器字号不变。
# 后台“内容与编辑设置”中可随时调整并即时生效。
# DOCUMENT_FONT_SIZE = 15

# APStack 接口管理。这里只配置服务地址，具体接口路径由应用维护。
# 使用 Docker 时，localhost 指向容器本身，请改为宿主机或接口服务的可访问地址。
APSTACK_API_BASE_URL = 'http://localhost:9988'
# APSTACK_API_TIMEOUT = 10

# The Logo can be the url of any image, even an attachment. e.g.:
# SITE_LOGO       = '//Home/a/logo.png'

# Permissions
# 'ANONYMOUS' or 'REGISTERED' or 'APPROVED'

READ_ACCESS       = 'ANONYMOUS'
WRITE_ACCESS      = 'REGISTERED'
ATTACHMENT_ACCESS = 'REGISTERED'
AUTO_APPROVAL     = True
EMAIL_NEEDS_CONFIRMATION = True
# NOTIFY_ADMINS_ON_REGISTER = True
# RETAIN_PAGE_NAME_CASE = False

# Database Configuration
# e.g. SQLALCHEMY_DATABASE_URI='sqlite:////absolute/path/to/the/sqlite/database/file'
# see https://flask-sqlalchemy.palletsprojects.com/en/2.x/config/#connection-uri-format
SQLALCHEMY_DATABASE_URI = ''

# Docker / TKE 容器部署时，将上述两项改为容器内的持久化路径：
# REPOSITORY = '/app-data/repository'
# SQLALCHEMY_DATABASE_URI = 'sqlite:////app-data/db.sqlite'
# TKE 可将本配置作为 Secret 挂载到 /config/settings.cfg，并设置环境变量
# OTTERWIKI_SETTINGS=/config/settings.cfg；完整模板见 deploy/tke/otterwiki.yaml.example。
# SECRET_KEY 使用固定随机值，APSTACK_API_BASE_URL 使用容器可访问的内网服务地址。

# # Flask-Mail configuration
# # See https://pythonhosted.org/Flask-Mail/ for configuration.

# MAIL_DEFAULT_SENDER='no-reply@otterwiki.YOUR-ORGANISATION.TLD'

# # Flask-Mail gmail
# MAIL_SERVER = 'smtp.googlemail.com'
# MAIL_PORT = 465
# MAIL_USE_TLS = False
# MAIL_USE_SSL = True
# MAIL_USERNAME = 'MAIL_USERNAME'
# MAIL_PASSWORD = 'MAIL_PASSWORD'

# # For debgging the mail configuration
# #
# #   ./venv/bin/pip install maildump && ./venv/bin/maildump
# #
# MAIL_SERVER = 'localhost'
# MAIL_PORT = 1025
# MAIL_USERNAME = None
# MAIL_PASSWORD = None

# 异步导入检查点目录；默认 REPOSITORY 父目录下 .otterwiki-import-tasks。
# 必须随数据库及仓库一起持久化；不要指向临时目录。
# DOCUMENT_IMPORT_TASK_ROOT = '/app-data/.otterwiki-import-tasks'
# NGINX_UWSGI_TIMEOUT 在容器环境变量中设置（默认600秒），不在此文件配置。

# 整站备份暂存目录；默认 REPOSITORY 同级 .otterwiki-site，必须持久化。
# 与数据库、仓库、SPACES_ROOT、DOCUMENT_IMPORT_TASK_ROOT 互不包含。
# SITE_BACKUP_ROOT = '/app-data/.otterwiki-site'
# 整站 ZIP 上传上限、解压上限和文件数上限（字节 / 个）。
# SITE_BACKUP_MAX_ARCHIVE_SIZE = 2 * 1024 * 1024 * 1024
# SITE_BACKUP_MAX_EXTRACTED_SIZE = 8 * 1024 * 1024 * 1024
# SITE_BACKUP_MAX_FILES = 200000
# 管理页导入在停站重启时生效；初始化命令见 docs/site-backup-and-reset.md。
